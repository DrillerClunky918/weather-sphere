{
  "compilerOptions": {
    "target": "es2022", 
    "module": "esnext", 
    "moduleResolution": "bundler", 
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}