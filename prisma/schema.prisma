// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id        Int       @id @default(autoincrement())
  name      String
  state     String
  lat       Float
  lng       Float
  reports   WeatherReport[]
}

model WeatherReport {
  id        Int      @id @default(autoincrement())
  aqi       Int      // Keeping this for legacy support
  
  // NEW COLUMNS
  pm10      Float?   @default(0) 
  pm25      Float?   @default(0) 

  temp      Float
  sources   String   @default("{}") // Stores PM2.5 breakdown
  timestamp DateTime @default(now())
  
  city      City     @relation(fields: [cityId], references: [id])
  cityId    Int
}
