generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model City {
  id      Int             @id @default(autoincrement())
  name    String
  state   String
  lat     Float
  lng     Float
  reports WeatherReport[]
}

model WeatherReport {
  id        Int      @id @default(autoincrement())
  cityId    Int
  pm25      Float
  pm10      Float
  ozone     Float
  methane   Float
  sources   String   @default("{}")
  createdAt DateTime @default(now())
  city      City     @relation(fields: [cityId], references: [id])
}
